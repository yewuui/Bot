# Salin file ini menjadi .env lalu isi sesuai konfigurasi lokalmu
BOT_TOKEN=123456789:ABCDEF_ganti_dengan_bot_token_telegram
ALLOWED_CHAT_ID=123456789

# Konfigurasi AI Router (OpenAI-compatible endpoint, misal 9router)
ROUTER_ENDPOINT=http://localhost:20128/v1/chat/completions
ROUTER_API_KEY=sk-ganti-dengan-api-key
ROUTER_MODEL=bot

# Opsional
LARAGON_EXE_PATH=D:\laragon\laragon.exe
EXCEL_SEED_PATH=
